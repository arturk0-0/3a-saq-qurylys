# Health/setup screen runs without credentials; analyst workspace requires Firebase.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Vite's proxy target (Docker Compose overrides this with http://backend:8000).
API_PROXY_TARGET=http://127.0.0.1:8000
# Production Hosting: Cloud Run HTTPS origin, without /api/v1. Empty for local Vite.
VITE_API_BASE_URL=

# Backend Firebase: enable after configuring the project and private credentials.
FIREBASE_ENABLED=false
FIREBASE_DEMO_ONLY=true
FIREBASE_PROJECT_ID=saq-qurylys
FIREBASE_CREDENTIALS_PATH=
# Host path for optional compose.firebase.yaml (use forward slashes on Windows).
FIREBASE_CREDENTIALS_FILE=
FIREBASE_STORAGE_BUCKET=
# Gemini: backend only; select an available model supporting structured output/images.
GEMINI_API_KEY=
MONITOR_DAILY_FETCH_LIMIT=100
MONITOR_SOURCES_PER_TICK=3
# Meta Ad Library via SearchAPI: backend only. Disabled until explicitly enabled.
SEARCHAPI_API_KEY=
SEARCHAPI_ENABLED=false
SEARCHAPI_SCHEDULE_ENABLED=false
SEARCHAPI_DAILY_LIMIT=2
SEARCHAPI_CREDIT_RESERVE=20
GEMINI_MODEL=
AI_DAILY_USER_LIMIT=20
AI_DAILY_GLOBAL_LIMIT=100

# Firebase browser configuration; never put Admin credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=saq-qurylys
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
