# Local skeleton: no external credentials required.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Vite's proxy target (Docker Compose overrides this with http://backend:8000).
API_PROXY_TARGET=http://127.0.0.1:8000

# Future backend integrations only; not used by the skeleton.
FIREBASE_PROJECT_ID=saq-qurylys
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=
GEMINI_API_KEY=
GEMINI_MODEL=

# Future Firebase browser configuration; never put Admin credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=saq-qurylys
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
